# if Vercel env vars are missing, so the demo still runs after merge.
NEXT_PUBLIC_SUPABASE_URL=https://cxhfmsnkcketqdlcqdic.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN4aGZtc25rY2tldHFkbGNxZGljIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxODc1MDQsImV4cCI6MjEwNDc2MzUwNH0.X358x5Ow8oTRhXlGoD9PQN-1KPfuS9QosgPT5DSMz6w
SUPABASE_SERVICE_ROLE_KEY=

# App session cookie (jose HS256). Optional — a demo secret is used if empty.
AUTH_SECRET=replace-with-long-random-string

# Demo organizer sign-in. Defaults to on when Auth0 is not configured.
# Set to false only if you want to require Auth0.
AUTH_DEV_BYPASS=true

# Auth0 Google (optional). Issuer may be with or without https://.
# In Auth0 → Application → Settings, Allowed Callback URLs must include:
#   https://converge.meetbhatt.com/api/auth/callback
#   http://localhost:3000/api/auth/callback
# Allowed Logout URLs / Web Origins: https://converge.meetbhatt.com
AUTH0_SECRET=
AUTH0_BASE_URL=https://converge.meetbhatt.com
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Day-of map (optional — stub canvas if empty)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
